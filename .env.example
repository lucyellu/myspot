# myspot configuration — copy this file to `.env` and fill in your keys.
# `.env` is gitignored; only `.env.example` is committed.
#
# Resolution order (each key): process env var → secrets/<KEY>.txt → this file.
# Restart `start.bat` (or `python -m backend.app`) after editing.

# --- Claude (prompt enhancer) ---
# Get one at: https://console.anthropic.com/settings/keys
# Pricing: pay-as-you-go (typical prompt enhance call costs <$0.001).
ANTHROPIC_API_KEY=

# --- DeepSeek (prompt enhancer, cheaper alternative to Claude) ---
# Get one at: https://platform.deepseek.com/api_keys
# Pricing: ~$0.14 per million input tokens (deepseek-chat / V3).
DEEPSEEK_API_KEY=

# --- Google Gemini (Nano Banana image gen + image-to-prompt vision) ---
# Get one at: https://aistudio.google.com/apikey
# Pricing: free tier covers ~500 images/day on gemini-2.5-flash-image.
# The same key is also used for vision-based "inspire from image".
GEMINI_API_KEY=

# --- OpenAI GPT Image (highest-quality paid image gen) ---
# Get one at: https://platform.openai.com/api-keys
# Models exposed in myspot: gpt-image-2, gpt-image-1.5, gpt-image-1-mini.
# Requires API billing/credits; Codex in-app usage limits are separate.
OPENAI_API_KEY=

# --- xAI Grok Imagine (image gen) ---
# Get one at: https://console.x.ai/  (then "API Keys" in the left nav)
# Pricing: $0.02 per image (no free tier as of March 2026).
XAI_API_KEY=

# --- HuggingFace Inference Providers (premium FLUX + image-to-video) ---
# Get one at: https://huggingface.co/settings/tokens  (read scope is enough)
# Free tier: ~$0.10/month credit (~30 FLUX-schnell images or ~3 LTX-Video clips).
# HF Pro ($9/mo): ~$2/month credit (~600 images or ~60 video clips).
# Models: FLUX.1-schnell (image), LTX-Video (image-to-video), CogVideoX-5b (image-to-video).
HF_TOKEN=

# --- Library / sync paths (override only if you've moved them) ---
# Defaults: C:/Users/lucyl/Desktop/suno_library and .../suno-dl/suno_meta.db
# SUNO_LIBRARY=L:/Projects/suno_library
# SUNO_META_DB=L:/Projects/suno-dl/suno_meta.db
# Default media/art browser root:
# ASSETS_DIR=L:/Media/Audio/suno/albumart
